{
    "name": "arkecosystem/crypto",
    "description": "A simple PHP Cryptography Implementation for the Ark Blockchain.",
    "keywords": [
        "api",
        "ark",
        "blockchain",
        "crypto",
        "currency"
    ],
    "license": "MIT",
    "authors": [
        {
            "name": "ARK Ecosystem",
            "email": "info@arkscic.com",
            "homepage": "https://arkscic.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "brick/math": "^0.14.2",
        "kornrunner/keccak": "^1.1",
        "protonlabs/bitcoin": "^1.0",
        "simplito/elliptic-php": "^1.0",
        "ext-gmp": "*"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.59",
        "graham-campbell/analyzer": "4.2.x-dev",
        "illuminate/support": "^12.18",
        "pestphp/pest": "^2.34",
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": {
            "ArkEcosystem\\Crypto\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "ArkEcosystem\\Tests\\Crypto\\": "tests"
        }
    },
    "config": {
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "extra": {
        "branch-alias": {
            "dev-master": "1.0-dev"
        }
    },
    "repositories": [
        {
            "url": "https://github.com/alexbarnsley/GrahamCampbell-Analyzer.git",
            "type": "git"
        }
    ],
    "scripts": {
        "post-update-cmd": [
            "npx @ardenthq/airc update"
        ],
        "format": [
            "vendor/bin/php-cs-fixer fix"
        ],
        "test": [
            "./vendor/bin/pest --coverage --min=100 --coverage-html=.coverage --coverage-clover=coverage.xml"
        ]
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
